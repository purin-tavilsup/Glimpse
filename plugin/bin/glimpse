#!/usr/bin/env bash
# Glimpse CLI on PATH (via the plugin's bin/). Resolves this script's REAL location
# through the install symlink — without `readlink -f` (unsupported on macOS) — then runs
# the in-repo built DLL, rebuilding it when the source changed so it's always current.
# With no clone around it (a marketplace install), it runs the released tool this plugin pins.
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ $src != /* ]] && src="$dir/$src"
done
bin_dir="$(cd -P "$(dirname "$src")" && pwd)"
repo="$(cd "$bin_dir/../.." && pwd)"   # plugin/bin -> plugin -> repo
project="$repo/tools/Glimpse.Capture/Glimpse.Capture.csproj"
dll="$repo/tools/Glimpse.Capture/bin/Debug/net10.0/Glimpse.Capture.dll"

if ! command -v dotnet >/dev/null 2>&1; then
    echo "glimpse: needs the .NET 10 SDK (dotnet on PATH): https://dot.net" >&2
    exit 127
fi

if [ ! -f "$project" ]; then
    # --yes skips dnx's download prompt, which would hang a non-interactive caller.
    version="$(tr -d '[:space:]' < "$bin_dir/glimpse.version")"

    # On macOS, the dnx run that downloads the package prints a NuGet signature notice on stdout, ahead of
    # Glimpse's own output, which callers parse. A silent run downloads it first. NuGet lowercases the
    # cache folder names; `tr` rather than ${var,,} because macOS ships bash 3.2.
    cached="${NUGET_PACKAGES:-$HOME/.nuget/packages}/glimpse.capture/$(printf '%s' "$version" | tr '[:upper:]' '[:lower:]')"
    if [ ! -d "$cached" ]; then
        dotnet dnx "Glimpse.Capture@$version" --yes -- --version >/dev/null 2>&1 || true
    fi
    exec dotnet dnx "Glimpse.Capture@$version" --yes -- "$@"
fi

# Rebuild when a source file changed since the last build, so a pull or an edit goes live. A stamp, not the DLL,
# marks the build: a change that leaves a dependency's public API alone can leave the DLL untouched, which would
# make every later call rebuild.
stamp="$repo/tools/Glimpse.Capture/obj/glimpse-wrapper.stamp"
if [ ! -f "$dll" ] || [ ! -f "$stamp" ] || [ -n "$(
    find "$repo/tools/Glimpse.Capture" "$repo/src" \( -name '*.cs' -o -name '*.csproj' -o -name '*.props' \) \
        -not -path '*/bin/*' -not -path '*/obj/*' -newer "$stamp" -print -quit
    find "$repo" -maxdepth 1 -name 'Directory.*.props' -newer "$stamp" -print -quit
)" ]; then
    dotnet build "$project" -v quiet >&2
    touch "$stamp"
fi
exec dotnet "$dll" "$@"
