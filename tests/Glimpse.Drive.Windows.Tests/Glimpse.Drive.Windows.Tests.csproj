<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests of the Windows driver, which runs only on Windows: `dotnet test` on other operating systems skips
       this project instead of failing to start it. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
    <IsTestProject Condition="!$([MSBuild]::IsOSPlatform('Windows'))">false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FlaUI.UIA3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tools\Glimpse.Drive\Glimpse.Drive.csproj" />
  </ItemGroup>

</Project>
