<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- The cross-platform CLI package. Releases publish it to NuGet; a plugin installed from a
       marketplace runs the version it pins through `dotnet dnx`, and `dotnet tool install` works too. -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>glimpse</ToolCommandName>
    <PackageId>Glimpse.Capture</PackageId>
    <Version>0.1.1</Version>
    <Authors>Purin Tavilsup</Authors>
    <Description>Render any UI or diagram to a PNG so an agent can see it, critique it, and iterate.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/purin-tavilsup/Glimpse</PackageProjectUrl>
    <RepositoryUrl>https://github.com/purin-tavilsup/Glimpse</RepositoryUrl>
    <PackageTags>screenshot;diagram;mermaid;graphviz;d2;visual-feedback;agent</PackageTags>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../artifacts/nupkg</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Glimpse.Abstractions\Glimpse.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Glimpse.Core\Glimpse.Core.csproj" />
  </ItemGroup>

</Project>
